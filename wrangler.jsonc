{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poshservices",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "poshservices.carlosfandango.net", "custom_domain": true }
  ]
}
